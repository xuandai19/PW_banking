# MySQL (khi chạy Docker, các biến này được docker-compose ghi đè)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=banking_db

# JWT - bắt buộc, tối thiểu 32 ký tự
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=7200

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# Email: console | ethereal | smtp
EMAIL_MODE=console
EMAIL_FROM=Banking System <noreply@banking.local>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
